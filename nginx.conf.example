# SPA fallback for nginx.
#
# Copy this block into your server{} or location / {} — all unknown paths must
# serve index.html so client-side routes (/pornstar/:slug) work on direct
# navigation and refresh.
#
#   root /var/www/performer-index/dist;
#   location / { try_files $uri $uri/ /index.html; }
#
# Immutable hashed assets can be cached aggressively:
#
#   location /assets/ {
#     expires 1y;
#     add_header Cache-Control "public, immutable";
#   }
